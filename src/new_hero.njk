---
layout: new_base.njk
title: Home
---

<section id="home" class="px-2">
  <div class="container-fluid w-100 mx-auto h-100">
    <div class="bento-grid">
      <!-- Row 1 -->
      <a href="{{ '/portfolio/omed_app/' | url }}" class="bento-item bento-omed animate-bento" style="animation-delay: 100ms;">
        <div class="bento-img-wrapper">
          <img src="{{ '/images/hero/omed.png' | url }}" class="bento-img bg-transparent border-0 shadow-none" alt="OMED App">
          <div class="gallery-overlay">
            <span class="gallery-title mt-auto pt-4">A mobile app to track digestive symptoms</span>
            <div class="mt-auto d-flex justify-content-end w-100 pt-3">
              <div class="project-link-btn">
                <i class="fa-solid fa-arrow-right icon-arrow-rotated"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
      <a href="{{ '/portfolio/crfs/' | url }}" class="bento-item bento-macha animate-bento p-3 p-md-4" style="animation-delay: 200ms;">
        <div class="bento-img-wrapper">
          <img src="{{ '/images/hero/voc.png' | url }}" class="bento-img bg-transparent border-0 shadow-none" alt="VOC">
        </div>
      </a>
      <a href="{{ '/portfolio/data_warehouse/' | url }}" class="bento-item bento-metabase animate-bento align-items-start" style="animation-delay: 300ms;">
        <div class="bento-img-wrapper">
          <img src="{{ '/images/hero/metabase.png' | url }}" class="bento-img bg-transparent border-0 shadow-none" alt="Dashboard">
          <div class="gallery-overlay">
            <span class="gallery-title mt-auto pt-4">Data Warehouse & BI Dashboards</span>
            <div class="mt-auto d-flex justify-content-end w-100 pt-3">
              <div class="project-link-btn">
                <i class="fa-solid fa-arrow-right icon-arrow-rotated"></i>
              </div>
            </div>
          </div>
        </div>
      </a>

      <!-- Row 2 -->
      <div class="bento-item bento-center animate-bento z-3" style="animation-delay: 400ms;">
        <div class="text-center w-100">
          <h1 class="hero-title mb-4 hero-title-fluid">
            <span class="fw-normal text-dark font-ubuntu"><br>I build tools that<br>make science</span><br>
            <span class="text-roller font-marko">
              <span class="roll-wrapper">
                <span class="roll-text">easier</span>
                <span class="roll-text">accessible</span>
                <span class="roll-text">robust</span>
                <span class="roll-text">fast</span>
                <span class="roll-text">intuitive</span>
                <span class="roll-text" aria-hidden="true">easier</span>
              </span>
            </span>
          </h1>
          <div class="btn-group gap-3" role="group" aria-label="hero buttons">
            <a href="{{ '/projects/' | url }}" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium fs-5">my work</a>
            <a href="{{ '/about/' | url }}" class="btn btn-light border text-secondary rounded-pill px-4 fw-medium fs-5">about me</a>
          </div>
        </div>
      </div>
      <a href="{{ '/portfolio/atlas/' | url }}" class="bento-item bento-sphere animate-bento p-2 p-md-4" style="animation-delay: 500ms;">
        <div class="bento-img-wrapper bento-img-wrapper--darken">
          <img src="{{ '/images/hero/voc_sphere.png' | url }}" class="bento-img bg-transparent border-0 shadow-none" alt="VOC Sphere">
        </div>
      </a>

      <!-- Row 3 -->
      <a href="{{ '/portfolio/atlas/' | url }}" class="bento-item bento-atlas animate-bento" style="animation-delay: 600ms;">
        <div class="bento-img-wrapper">
          <img src="{{ '/images/hero/atlas.png' | url }}" class="bento-img bg-transparent border-0 shadow-none" alt="VOC Atlas">
          <div class="gallery-overlay">
            <span class="gallery-title mt-auto pt-4">An open-access repository of compounds on breath</span>
            <div class="mt-auto d-flex justify-content-end w-100 pt-3">
              <div class="project-link-btn">
                <i class="fa-solid fa-arrow-right icon-arrow-rotated"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
      <a href="{{ '/portfolio/macha/' | url }}" class="bento-item bento-voc animate-bento align-items-start" style="animation-delay: 700ms;">
        <div class="bento-img-wrapper">
          <img src="{{ '/images/hero/macha.png' | url }}" class="bento-img bg-transparent border-0 shadow-none" alt="Macha">
          <div class="gallery-overlay">
            <span class="gallery-title mt-auto pt-4">Clinician's Web Portal</span>
            <div class="mt-auto d-flex justify-content-end w-100 pt-3">
              <div class="project-link-btn">
                <i class="fa-solid fa-arrow-right icon-arrow-rotated"></i>
              </div>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>
</section>

<section id="carousel" class="d-lg-none">
  {% include "components/gallery-carousel.njk" %}
</section>





<section id='padding' class="py-4 my-4"></section>
<section id='padding' class="py-4 my-4"></section>


<section id="projects" class="container mb-5 fade-in delay-5 pt-4 mt-4">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Featured Work</h2>
  <div class="row g-4 mt-2">
    {% for item in collections.portfolio | reverse %}
      {% if item.data.pinned %}
        <div class="col-12">
          {% include "components/project-card.njk" %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="d-flex justify-content-end mt-2">
    <a href="{{ '/projects/' | url }}" class="btn btn-outline-primary">See All Projects &rarr;</a>
  </div>
</section>

<section id="cv" class="container mb-5 fade-in delay-4 pt-4 mt-4">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Employment History</h2>
  <div class="timeline">
    {% for job in cv.employmentHistory %}
      {% include "components/employment-item.njk" %}
    {% endfor %}
  </div>
    <h2 class="mt-5 mb-4 pb-2 border-bottom font-heading">Qualifications</h2>
  <div class="timeline">
    {% for qual in cv.qualifications %}
      {% if qual.degree %}
        {% include "components/qual-item.njk" %}
      {% endif %}
    {% endfor %}
    </div>
    <div class="col-md-6">
      <div class="h-100 border-0">
        <div>
          <div class="cv-col">
            {% for qual in cv.qualifications %}
              {% if qual.name %}
                <div class="cert-chip d-flex align-items-center gap-2 px-3 py-2 w-100">
                  <div>
                    <b class="cert-chip-title fw-600">{{ qual.name }}</b>
                    {% if qual.institution %}
                      <div class="text-muted cert-chip-meta">{{ qual.institution }} &bull; {{ qual.year }}</div>
                    {% else %}
                      <div class="text-muted cert-chip-meta">{{ qual.year }}</div>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        </div>
    </div>
  </div>
</section>







</section>

