<div class="product {% if product.pinned %}product--pinned{% endif %}"{% if product.image and not product.link %} x-data="{ open: false }"{% endif %}>
  {% if product.image %}
    <div class="project-image-wrapper overflow-hidden">
      {% if product.link %}
        <a href="{{ product.link | url }}" class="text-decoration-none text-body text-dark" target="_blank" rel="noopener noreferrer">
          {{ product.image | imageHtml(product.name, "project-image w-100 object-fit-cover rounded-4") | safe }}
        </a>
      {% else %}
        <button class="product-image-btn" @click="open = true; $nextTick(() => $refs.lightbox.showModal())" aria-label="View full image of {{ product.name }}">
          {{ product.image | imageHtml(product.name, "project-image w-100 object-fit-cover rounded-4") | safe }}
        </button>
        <dialog class="lightbox" x-ref="lightbox" @click.self="open = false; $refs.lightbox.close()" @keydown.escape.window="open = false; $refs.lightbox.close()">
          <button class="lightbox__close" @click="open = false; $refs.lightbox.close()" aria-label="Close image">&times;</button>
          <img src="/{{ product.image }}" alt="{{ product.name }}" class="lightbox__img">
        </dialog>
      {% endif %}
    </div>
  {% endif %}
  <div class="product-content">
    <h3 class="fw-bold lh-sm text-dark">
        {{ product.name }}
    </h3>
    {% if product.roles %}
      <div class="product-role">
        <span>{{ product.roles | join(', ') }}</span>
      </div>
    {% endif %}
    {% if product.link %}
        <a href="{{ product.link | url }}" target="_blank" rel="noopener noreferrer">{{ product.link_title }}</a>
    {% endif %}
    <p class="product-description">{{ product.description }}</p>
    {% if product.related_articles %}
      <ul>
        {% for article in product.related_articles %}
          {% for post in collections.blog %}
            {% if post.fileSlug == article.slug %}
              <li>
                <a href="{{ post.url | url }}" class="text-decoration-none">
                  {{ article.title }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </ul>
    {% endif %}
    {% if product.stack %}
      <div class="product-stack">
        {% for tool in product.stack %}
          <span class="badge bg-secondary-subtle text-secondary me-1">{{ tool }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
