<div class="card shadow-sm border-0 bg-body text-center h-100 cert-card">
  <div class="card-body d-flex flex-column justify-content-center align-items-center p-3">
    <h3 class="card-title h6 font-heading mb-2">
      {% if cert.link %}
        <a href="{{ cert.link | url }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-body-emphasis stretched-link">
          {{ cert.name }}
        </a>
      {% else %}
        {{ cert.name }}
      {% endif %}
    </h3>
    <h6 class="card-subtitle mt-1 mb-2 text-body-secondary text-uppercase fw-medium letter-spacing-1">
      {{ cert.issuer }}
    </h6>
    <div class="mt-auto text-body-tertiary fw-bold small">{{cert.year}}</div>
  </div>
</div>
