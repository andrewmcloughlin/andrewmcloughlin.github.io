---
layout: base.njk
---
<div class="item-layout">
  <aside class="item-sidebar d-none d-lg-flex flex-column" aria-label="All articles">
    <nav class="item-sidebar__nav">
      <p class="item-sidebar__heading text-uppercase fw-semibold small mb-3 text-secondary">Articles</p>
      <ul class="list-unstyled mb-0">
        {% set sortedBlog = collections.blog | sort(false, false, 'data.order') %}
        {% for item in sortedBlog %}
          <li>
            <a href="{{ item.url | url }}"
               class="item-sidebar__link nav-link{% if page.url == item.url %} active{% endif %}">
              {{ item.data.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>

  <div class="item-main">
    {% set sortedBlog = collections.blog | sort(false, false, 'data.order') %}
    {% set currentIndex = 0 %}
    {% for item in sortedBlog %}
      {% if page.url == item.url %}
        {% set currentIndex = loop.index0 %}
      {% endif %}
    {% endfor %}
    {% set prevItem = sortedBlog[currentIndex - 1] if currentIndex > 0 else null %}
    {% set nextItem = sortedBlog[currentIndex + 1] if currentIndex < (sortedBlog | length - 1) else null %}

    <script>
      window.__pageShortcuts = [
        {% if prevItem %}{ "code": "k", "title": "Prev: {{ prevItem.data.title }}", "url": "{{ prevItem.url | url }}" }{% if nextItem %},{% endif %}{% endif %}
        {% if nextItem %}{ "code": "j", "title": "Next: {{ nextItem.data.title }}", "url": "{{ nextItem.url | url }}" }{% endif %}
      ];
    </script>

    <article class="card mb-5 border-0 shadow-sm">
      <div class="card-body p-4 p-md-5 p-lg-5">
        <div class="d-flex flex-wrap gap-2 mb-4" aria-label="Technology stack">
          {% if featured_stack %}
            {% for tool in featured_stack %}
              <span class="badge bg-primary-subtle text-primary">{{ tool }}</span>
            {% endfor %}
          {% endif %}
          {% if other_stack %}
            {% for tool in other_stack %}
              <span class="badge bg-primary-subtle text-primary me-1">{{ tool }}</span>
            {% endfor %}
          {% endif %}
        </div>

        <header class="mb-5 pb-2">
          <h1 class="display-5 fw-bold mb-4">{{ title }}</h1>
          <p class="card-subtitle lead text-secondary mb-3">{{ description }}</p>
        </header>

        {% if image %}
          {{ image | imageHtml(title, "img-fluid rounded-4 mb-5 w-100 shadow-sm") | safe }}
        {% endif %}

        <div class="card-text border-top pt-5 mt-2">
          {{ content | safe }}
        </div>

        <nav class="mt-5 d-flex justify-content-between" aria-label="Article navigation">
          {% if prevItem %}
            <a href="{{ prevItem.url | url }}" class="btn btn-arrow-left">{{ prevItem.data.title }}</a>
          {% else %}
            <span></span>
          {% endif %}
          {% if nextItem %}
            <a href="{{ nextItem.url | url }}" class="btn">{{ nextItem.data.title }}</a>
          {% endif %}
        </nav>
      </div>
    </article>
  </div>
</div>