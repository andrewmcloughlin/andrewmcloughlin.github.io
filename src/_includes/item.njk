---
layout: base.njk
---
<div class="row justify-content-center">
  <div class="col-md-10 col-lg-8">
    <div class="card shadow-sm border-0 mb-5">
      <div class="card-body p-4 p-md-5">
        <div class="d-flex flex-wrap gap-2 mb-3">
          <span class="badge bg-secondary text-light">
            {% for tag in tags %}
              {% if tag != "portfolio" %}{{ tag }} {% endif %}
            {% endfor %}
          </span>
          {% if stack %}
            {% for tool in stack %}
              <span class="badge bg-primary">{{ tool }}</span>
            {% endfor %}
          {% endif %}
        </div>
        
        <h1 class="card-title display-5 fw-bold mb-3">{{ title }}</h1>
        <p class="card-subtitle lead text-secondary mb-4">{{ description }}</p>
        
        <div class="card-text border-top pt-4">
          {{ content | safe }}
        </div>
        
        <div class="mt-5">
          <a href="/portfolio/" class="btn btn-outline-primary">&larr; Back to Portfolio</a>
        </div>
      </div>
    </div>
  </div>
</div>
