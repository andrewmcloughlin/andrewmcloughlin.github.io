---
layout: base.njk
---
<div class="item-layout">
  <aside class="item-sidebar" aria-label="All articles">
    <nav class="item-sidebar__nav">
      <ul class="list-unstyled">
        {% set sortedBlog = collections.blog | sort(false, false, 'data.order') %}
        {% for item in sortedBlog %}
          <li>
            <a href="{{ item.url | url }}"
               class="item-sidebar__link nav-link{% if page.url == item.url %} active{% endif %}">
              {{ item.data.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>

  <div class="item-main">
    {% set sortedBlog = collections.blog | sort(false, false, 'data.order') %}
    {% set currentIndex = 0 %}
    {% for item in sortedBlog %}
      {% if page.url == item.url %}
        {% set currentIndex = loop.index0 %}
      {% endif %}
    {% endfor %}
    {% set prevItem = sortedBlog[currentIndex - 1] if currentIndex > 0 else null %}
    {% set nextItem = sortedBlog[currentIndex + 1] if currentIndex < (sortedBlog | length - 1) else null %}

    <script>
      window.__pageShortcuts = [
        {% if prevItem %}{ "code": "k", "title": "Prev: {{ prevItem.data.title }}", "url": "{{ prevItem.url | url }}" }{% if nextItem %},{% endif %}{% endif %}
        {% if nextItem %}{ "code": "j", "title": "Next: {{ nextItem.data.title }}", "url": "{{ nextItem.url | url }}" }{% endif %}
      ];
    </script>

    <article class="card border-0">
      <div class="card-body -5 -5">
        <div class="gap-2" aria-label="Technology stack">
          {% if featured_stack %}
            {% for tool in featured_stack %}
              <span class="badge bg-primary-subtle text-primary">{{ tool }}</span>
            {% endfor %}
          {% endif %}
          {% if other_stack %}
            {% for tool in other_stack %}
              <span class="badge bg-primary-subtle text-primary me-1">{{ tool }}</span>
            {% endfor %}
          {% endif %}
        </div>

        <header >
          <h1 class="display-5 fw-bold">{{ title }}</h1>
          <p class="card-subtitle lead text-secondary">{{ description }}</p>
        </header>

        {% if image %}
          {{ image | imageHtml(title, "img-fluid rounded-4 mb-5 w-100 shadow-sm") | safe }}
        {% endif %}

        <div class="card-text border-top">
          {{ content | safe }}
        </div>

        <nav  aria-label="Article navigation">
          {% if prevItem %}
            <ul class="shortcuts-list">
              <li><a href="{{ prevItem.url | url }}" ><kbd>k</kbd><span> Previous post</span></a></li>
              </ul>
              {% else %}
              <span></span>
              {% endif %}
              {% if nextItem %}
              <ul class="shortcuts-list">
                <li><a href="{{ nextItem.url | url }}" ><kbd>j</kbd><span> Next post</span></a></li>
              </ul>
            {% endif %}

        </nav>
      </div>
    </article>
  </div>
</div>