<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Portfolio") }} - {{ site.name }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <!-- Local Fonts: Bricolage Grotesque, xkcd -->
  <link href="{{ '/css/vendor/splide.min.css' | url }}" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="stylesheet" href="{{ '/fontawesome/css/all.min.css' | url }}">
  
  <!-- Favicons -->
  <meta name="theme-color" content="#fe8246" />
  <meta name="application-name" content="Andrew McLoughlin" />
  <link rel="icon" type="image/x-icon" href="images/favicons/favicon.ico" />
  <link rel="icon" type="image/png" href="images/favicons/favicon-196x196.png" sizes="196x196" />
  <link rel="icon" type="image/png" href="images/favicons/favicon-128x128.png" sizes="128x128" />
  <link rel="icon" type="image/png" href="images/favicons/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/png" href="images/favicons/favicon-32x32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="images/favicons/favicon-16x16.png" sizes="16x16" />
  <link rel="apple-touch-icon" sizes="196x196" href="images/favicons/favicon-196x196.png" />
  <link rel="manifest" href="images/favicons/site.webmanifest" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "author": {
      "@type": "Person",
      "name": "{{ site.author.name }}"
    }
  }
  </script>
  <a href="#main" class="visually-hidden focusable">Skip to main content</a>
</head>
<body tabindex="0">
  <header class="site-header">
    <div class="nav-container">
      <nav class="mobile-topnav" id="topNav">
        <ul class="nav gap-1">
          {% for link in site.nav %}
          <li class="nav-item"><a href="{{ link.url | url }}" data-shortcut="{{ link.code }}" class="nav-link{% if page.url == link.url %} active{% endif %}"{% if page.url == link.url %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <button type="button" id="theme-toggle" class="theme-toggle-pill" aria-label="Switch to dark mode" aria-pressed="false"> 
        <i class="fa-solid fa-moon theme-icon"></i>
      </button>
    </div>
  </header>

  <div class="page-wrapper">
    <main class="page-main flex-grow-1">
      {{ content | safe }}
    </main>
  </div>

  <footer class="site-footer">
    <a href="/">
      <b class="fs-1 fw-bold">Andrew McLoughlin</b>
    </a>
    <div class="footer-links">
      <ul>
        {% for link in site.social %}
        <li><a href="{{ link.url }}" data-shortcut="{{ link.code }}" target="_blank">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
      <ul>
        {% for link in site.footer.nav %}
        <li><a href="{{ link.url | url }}" data-shortcut="{{ link.code }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    <div class="footer-hint">
      <small>Press <kbd class="keyboard-icon">\</kbd> for shortcuts</small>
    </div>
  </footer>

  <script src="{{ '/js/vendor/splide.min.js' | url }}"></script>
  <script src="{{ '/js/vendor/splide-extension-auto-scroll.min.js' | url }}"></script>
  <script>window.__pathPrefix = "{{ '/' | url }}";</script>
  <script src="{{ '/js/theme.js' | url }}"></script>
  <script defer src="{{ '/js/vendor/alpine.min.js' | url }}"></script>
  <script src="{{ '/js/shortcuts.js' | url }}"></script>
</body>
</html>
