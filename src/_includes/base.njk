<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Portfolio") }} - {{ site.name }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <!-- Local Fonts: Bricolage Grotesque, xkcd -->
  <link href="{{ '/css/vendor/splide.min.css' | url }}" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="stylesheet" href="{{ '/fontawesome/css/all.min.css' | url }}">
  
  <!-- Favicons -->
  <meta name="theme-color" content="#fe8246" />
  <meta name="application-name" content="Andrew McLoughlin" />
  <link rel="icon" type="image/x-icon" href="{{ '/images/favicons/favicon.ico' | url }}" />
  <link rel="icon" type="image/png" href="{{ '/images/favicons/favicon-196x196.png' | url }}" sizes="196x196" />
  <link rel="icon" type="image/png" href="{{ '/images/favicons/favicon-128x128.png' | url }}" sizes="128x128" />
  <link rel="icon" type="image/png" href="{{ '/images/favicons/favicon-96x96.png' | url }}" sizes="96x96" />
  <link rel="icon" type="image/png" href="{{ '/images/favicons/favicon-32x32.png' | url }}" sizes="32x32" />
  <link rel="icon" type="image/png" href="{{ '/images/favicons/favicon-16x16.png' | url }}" sizes="16x16" />
  <link rel="apple-touch-icon" sizes="196x196" href="{{ '/images/favicons/favicon-196x196.png' | url }}" />
  <link rel="manifest" href="{{ '/images/favicons/site.webmanifest' | url }}" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "author": {
      "@type": "Person",
      "name": "{{ site.author.name }}"
    }
    "address": "Cambridge, UK",
    "pronouns": "he,him,his",
    "knowsAbout": "Python, Django, SQL",
    "skills": "Data Management, Data Engineering",
    "alumniOf": "University of Cambridge, University of Warwick",
  }
  </script>
</head>
<body>
  <a href="#main" class="visually-hidden focusable">Skip to main content</a>
  <header class="site-header">
    <div class="nav-container">
      <nav class="mobile-topnav" id="topNav">
        <ul class="nav gap-1">
          {% for link in site.nav %}
          <li class="nav-item"><a href="{{ link.url | url }}" class="nav-link{% if page.url == link.url %} active{% endif %}"{% if page.url == link.url %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <button type="button" id="theme-toggle" class="theme-toggle-pill" aria-label="Switch to dark mode" aria-pressed="false" > 
        <i class="fa-solid fa-moon theme-icon"></i>
      </button>
    </div>
  </header>

  <div class="page-wrapper">
    <main id="main" class="page-main flex-grow-1">
      {{ content | safe }}
    </main>
  </div>

  <footer class="site-footer">
    <a href="/">
      <b class="fs-1 fw-bold" data-ssml-phoneme-alphabet="ipa" data-ssml-phoneme-ph={{ site.ipa_pronounciation }}>{{ site.name }}</b>
    </a>
    <div class="footer-links pt-2">
      <ul>
        {% for link in site.social %}
        <li><a href="{{ link.url }}" target="_blank">{{ link.title }}</a></li>
        {% endfor %}
        <li x-data="{ p1: 'andrew', p2: 'mcloughlin', p3: 'cantab', p4:'net' }"><a x-bind:href="`mailto:${p1}.${p2}@${p3}.${p4}`" class="email-link">Email</a></li>
      </ul>
      <ul>
        {% for link in site.footer.nav %}
        <li><a href="{{ link.url | url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    <div class="footer-hint">
      <button
        type="button"
        id="shortcuts-trigger"
        class="shortcuts-trigger"
        aria-haspopup="dialog"
        aria-controls="shortcuts-dialog">
        Keyboard shortcuts <kbd class="keyboard-icon">\</kbd>
      </button>
    </div>
    <button type="button" id="theme-toggle-mobile" class="mobile-toggle lamp" aria-label="Switch to dark mode" aria-pressed="false"> 
      <i class="fa-solid fa-moon theme-icon"></i>
    </button>
  </footer>

  <dialog id="shortcuts-dialog" aria-labelledby="shortcuts-title" class="shortcuts-dialog">
    <div class="shortcuts-dialog-content">
      <h2 id="shortcuts-title" class="h3 mb-1">Keyboard shortcuts</h2>
      
      <ul class="shortcuts-list" id="shortcuts-list">
        <li><kbd>\</kbd> <span>Open shortcuts</span></li>
        <li><kbd>Esc</kbd> <span>Close panel</span></li>
        {% for shortcut in site.shortcuts %}
        <li><kbd>{{ shortcut.code }}</kbd> <span>{{ shortcut.title }}</span></li>
        {% endfor %}
      </ul>

      <div class="shortcuts-settings mt-2">
        <label>
          <input type="checkbox" id="enable-char-shortcuts">
          Enable keyboard shortcuts
        </label>
      </div>

      <div class="mt-2 text-end">
        <button type="button" class="btn" id="close-shortcuts-dialog">Close</button>
      </div>
    </div>
  </dialog>

  <script src="{{ '/js/vendor/splide.min.js' | url }}"></script>
  <script src="{{ '/js/vendor/splide-extension-auto-scroll.min.js' | url }}"></script>
  <script>
    window.__pathPrefix = "{{ '/' | url }}";
    window.__shortcuts = {{ site.shortcuts | dump | safe }};
  </script>
  <script src="{{ '/js/theme.js' | url }}"></script>
  <script defer src="{{ '/js/vendor/alpine.min.js' | url }}"></script>
  <script src="{{ '/js/shortcuts.js' | url }}"></script>
</body>
</html>
