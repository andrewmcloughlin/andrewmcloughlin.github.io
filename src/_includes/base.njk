<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default("Portfolio") }} - {{ site.name }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/css/splide.min.css" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body data-bs-spy="scroll" data-bs-target="#sideNav" data-bs-offset="80" tabindex="0">
  <header>
    <!-- Mobile / small-screen top navbar -->
    <nav class="d-lg-none mobile-topnav" id="topNav">
      <ul class="nav nav-pills justify-content-center" id="mobileScrollNav">
        {% set navPrefix = "" if page.url == "/" else ("/" | url) %}
        <li class="nav-item"><a href="{{ navPrefix }}#home" class="nav-link">Home</a></li>
        <li class="nav-item"><a href="{{ navPrefix }}#cv" class="nav-link">CV</a></li>
        <li class="nav-item"><a href="{{ navPrefix }}#projects" class="nav-link">My Work</a></li>
      </ul>
      <button id="theme-toggle-mobile" class="btn btn-outline-secondary border-0 btn-sm ms-auto" aria-label="Toggle theme"><i class="fa-solid fa-moon theme-icon"></i></button>
    </nav>
  </header>

  <div class="spa-wrapper">
    <!-- Large-screen sidebar scrollspy nav -->
    <nav id="sideNav" class="d-none d-lg-flex flex-column sidebar-nav">
      <a class="sidebar-brand fw-bold mb-4" href="{{ '/' | url }}">{{ site.name }}</a>
      <ul class="nav flex-column nav-pills mb-auto" id="sideScrollNav">
        {% set navPrefix = "" if page.url == "/" else ("/" | url) %}
        <li class="nav-item"><a href="{{ navPrefix }}#home" class="nav-link">Home</a></li>
        <li class="nav-item"><a href="{{ navPrefix }}#cv" class="nav-link">CV</a></li>
        <li class="nav-item"><a href="{{ navPrefix }}#projects" class="nav-link">My Work</a></li>
      </ul>
      <div class="mt-auto pt-3">
        <button id="theme-toggle" class="btn btn-outline-secondary border-0 w-100" aria-label="Toggle theme"><i class="fa-solid fa-moon theme-icon"></i></button>
      </div>
    </nav>

    <main class="spa-main flex-grow-1">
      {{ content | safe }}
    </main>
  </div>

  <footer class="site-footer flex-column align-items-center">
    <div class="d-flex gap-4">
      <a href="https://linkedin.com/in/amcloughlin1" target="_blank" rel="noopener" aria-label="LinkedIn">
        <i class="fa-brands fa-linkedin"></i>
      </a>
      <a href="https://cambridge.academia.edu/AndrewMcLoughlin" target="_blank" rel="noopener" aria-label="Academia">
        <i class="fa-solid fa-graduation-cap"></i>
      </a>
      <a href="https://figma.com/@maclin" target="_blank" rel="noopener" aria-label="Figma">
        <i class="fa-brands fa-figma"></i>
      </a>
    </div>
    <div class="mt-2 text-center">
      <a href="{{ '/about/' | url }}" class="text-decoration-none" style="font-size: 0.95rem; opacity: 0.7;">About this site</a>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide@4.1.4/dist/js/splide.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@splidejs/splide-extension-auto-scroll@0.5.3/dist/js/splide-extension-auto-scroll.min.js"></script>
  <script>window.__pathPrefix = "{{ '/' | url }}";</script>
  <script src="{{ '/js/theme.js' | url }}"></script>
  <script src="{{ '/js/scrollspy.js' | url }}"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>
  <button id="scroll-top-fab" class="d-lg-none fab" aria-label="Scroll to top">
    <i class="fa-solid fa-arrow-up"></i>
  </button>
</body>
</html>
