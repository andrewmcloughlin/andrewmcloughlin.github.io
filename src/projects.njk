---
layout: base.njk
title: All Projects
description: Browse all projects by Andrew McLoughlin, filtered by technology stack or category.
---

<section class="spa-section mb-5" x-data="{ filter: 'all', stackFilter: '' }">
  <h2 class="mb-4 pb-2 border-bottom" style="font-family: var(--font-heading);">All Projects</h2>

  <div class="d-flex justify-content-center align-items-center gap-2 mb-4 flex-wrap">
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'all' }"      @click="filter = 'all'; stackFilter = ''">All</button>
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'Product' }"       @click="filter = 'Product'; stackFilter = ''">Product</button>
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'Software' }" @click="filter = 'Software'; stackFilter = ''">Software</button>
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'Data' }" @click="filter = 'Data'; stackFilter = ''">Data</button>
    <template x-if="filter === 'Software'">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="text-muted" style="opacity: 0.4; font-size: 1.2rem; line-height: 1;">|</span>
        {% for stackItem in collections.stackItems %}
          <button class="btn btn-outline-secondary" :class="{ 'active': stackFilter === '{{ stackItem }}' }" @click="stackFilter = stackFilter === '{{ stackItem }}' ? '' : '{{ stackItem }}'">{{ stackItem }}</button>
        {% endfor %}
      </div>
    </template>
  </div>

  <div class="row g-4">
    {% for item in collections.portfolio | reverse %}
        <div class="col-12 portfolio-item" x-show="filter === 'all' || ('{{ item.data.tags | join(',') }}'.split(',').includes(filter) && (filter !== 'Software' || !stackFilter || '{{ (item.data.featured_stack or []) | join(',') }}'.split(',').includes(stackFilter)))" x-transition.opacity.duration.400ms>
          <div class="project-card position-relative d-flex flex-column flex-md-row gap-4 mb-5">
            {% if item.data.image %}
              <div class="project-image-wrapper w-100 w-md-65">
                <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="project-image w-100" style="object-fit: cover;">
              </div>
            {% endif %}
            <div class="project-content d-flex flex-column w-100 w-md-35 py-md-3 pe-md-3">
              <h3 class="project-title mb-3"><a href="{{ item.url | url }}" class="stretched-link text-decoration-none text-body">{{ item.data.title }}</a></h3>
              <p class="text-secondary" style="font-size: 1.1rem;">{{ item.data.description }}</p>
              {% if item.data.featured_stack %}
                <div class="mt-2 mb-4">
                  {% for tool in item.data.featured_stack %}
                    <span class="badge bg-secondary-subtle text-secondary me-1">{{ tool }}</span>
                  {% endfor %}
                  {% if item.data.other_stack %}
                    {% set count = item.data.other_stack | length %}
                    <span class="badge bg-secondary-subtle text-secondary me-1">+{{ count }}</span>
                  {% endif %}
                </div>
              {% endif %}
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
    {% endfor %}
  </div>
</section>
