---
layout: base.njk
title: Curriculum Vitae
---

<section class="mb-5">
  <h2 class="mb-4 pb-2 border-bottom">Employment History</h2>
  <div class="timeline">
    {% for job in cv.employmentHistory %}
      <div class="card timeline-item mb-4 shadow-sm border-0 bg-transparent">
        <div class="card-body">
          {% if job.link %}
            <a href="{{ job.link }}" target="_blank" rel="noopener noreferrer">
          {% endif %}
            <h3 class="card-title h4">{{ job.role }}</h3>
            <h6 class="card-subtitle mb-3 text-primary">{{ job.company }} &bull; {{ job.duration }}</h6>
            <p class="card-text">{{ job.description }}</p>
          {% if job.link %}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<section class="mb-5">
  <h2 class="mb-4 pb-2 border-bottom">Qualifications</h2>
  <div class="row g-4 mt-2">
    {% for qual in cv.qualifications %}
      <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body">
          {% if qual.link %}
            <a href="{{ qual.link }}" target="_blank" rel="noopener noreferrer">
          {% endif %}
            <h3 class="card-title h4">{{ qual.degree }}</h3>
            <h6 class="card-subtitle mb-3 text-primary">{{ qual.institution }} &bull; {{ qual.year }}</h6>
            <p class="card-text">{{ qual.description }}</p>
          {% if qual.link %}
            </a>
          {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
