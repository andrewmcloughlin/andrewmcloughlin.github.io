---
layout: base.njk
title: Home
---


<section class="py-5 my-5">
  <h1 class="my-5 pt-5 fs-1 fw-semibold">Andrew McLoughlin</h1>
</section>

<section id="employment" class="spa-section mb-5 fade-in delay-4 py-5 mt-5">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Employment History</h2>
  <div class="timeline card">
    {% for job in cv.employmentHistory %}
    {% include "components/employment-item.njk" %}
    {% endfor %}
  </div>
</section>

<section id="qualifications" class="spa-section mb-5 fade-in delay-5 py-5">
  <h2 class="my-4 py-2 border-bottom font-heading">Qualifications</h2>
  <div class="timeline mb-4 pb-4">
    {% for qual in cv.qualifications %}
      {% include "components/qual-item.njk" %}
    {% endfor %}
  </div>
  <h2 id="certificates" class="my-4 py-2 border-bottom font-heading pt-4">Certificates</h2>
  <div class="row flex-wrap g-4 mt-2 d-flex align-items-stretch">
    {% for cert in cv.certificates %}
      <div class="col-md-6 col-lg-4">
        {% include "components/cert-item.njk" %}
      </div>
    {% endfor %}
  </div>
</section>

<section id="publications" class="spa-section mb-5 fade-in delay-5 py-5">
  <h2 class="my-4 py-2 border-bottom font-heading">Publications</h2>
  <div class="row g-4 mt-2">
    {% for pub in cv.publications %}
      <div class="col-12">
        {% include "components/pub-card.njk" %}
      </div>
    {% endfor %}
  </div>
  <div class="d-flex justify-content-end mt-4">
    <a href="https://cambridge.academia.edu/AndrewMcLoughlin" target="_blank" rel="noopener noreferrer" class="btn btn-outline w-100 py-2">More Publications &rarr;</a>
  </div>
</section>

<section id="projects" class="spa-section mb-5 fade-in delay-5 py-5 mt-5">
  <h2 class="my-4 py-4 border-bottom font-heading text-center">Featured Work</h2>
  {% include "components/gallery-carousel.njk" %}
  <div class="row g-4 mt-4 pt-4">

    {% for item in collections.portfolio | sort(attribute="data.order") %}
      {% if item.data.pinned %}
        <div class="col-12">
          {% include "components/project-card.njk" %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="d-flex justify-content-end mt-2">
    <a href="{{ '/work/' | url }}" class="btn btn-outline w-100 py-2">More Projects &rarr;</a>
  </div>
</section>


