---
layout: base.njk
title: Home
---

<section id="home" class="spa-section text-center align-items-center py-5">
  <div class="d-flex flex-column align-items-start justify-content-center">
    <div class="d-flex justify-content-start fade-in delay-1">
      <h1 class="fs-3 fw-bold mb-4 pt-4 ps-4 pb-0 font-heading">Hi, I'm Andrew,</h1>
    </div>
    <h1 class="display-4 fw-bold hero-title mb-4 pt-0 pb-4 ps-4 fade-in delay-2 font-heading">I make scientific software</h1>
    <p class="lead ps-4">I'm a full-stack developer and product owner specialising in scientific software and data products. </p>
  </div>

  {% include "components/gallery-carousel.njk" %}

<section id="projects" class="spa-section mb-5 fade-in delay-5 py-5 mt-5">
  <h2 class="my-4 py-4 border-bottom font-heading">Featured Work</h2>
  <div class="row g-4 mt-2">
    {% for item in collections.portfolio | reverse %}
      {% if item.data.pinned %}
        <div class="col-12">
          {% include "components/project-card.njk" %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="d-flex justify-content-end mt-2">
    <a href="{{ '/projects/' | url }}" class="btn btn-outline-primary w-100">More &rarr;</a>
  </div>
</section>

<section id="employment" class="spa-section mb-5 fade-in delay-4 py-5">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Employment History</h2>
  <div class="timeline">
    {% for job in cv.employmentHistory %}
    {% include "components/employment-item.njk" %}
    {% endfor %}
  </div>
</section>

<section id="qualifications" class="spa-section mb-5 fade-in delay-5 py-5">
  <h2 class="my-4 py-2 border-bottom font-heading">Qualifications</h2>
  <div class="timeline">
    {% for qual in cv.qualifications %}
      {% include "components/qual-item.njk" %}
    {% endfor %}


    {% for cert in certificates %}
      {{cert}}
    {% endfor %}
  </div>
</section>



