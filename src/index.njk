---
layout: base.njk
title: Home
---

<section id="home" class="spa-section text-center py-5">
  <h1 class="display-4 fw-bold hero-title" style="font-family: 'Mackinac', serif;">Hi, I'm Andrew</h1>
  <p class="lead text-secondary my-4">I am a full-stack developer of scientific software based in Cambridge, UK.</p>
  <a href="#projects" class="btn btn-primary btn-lg mt-3 mb-5">View My Work</a>

  <div class="gallery-marquee-container mt-4 splide" id="gallery-carousel">
    <div class="splide__track">
      <ul class="splide__list">
        <li class="splide__slide"><img src="{{ '/images/gallery/atlas-web.png' | url }}" alt="Atlas Web" class="gallery-img"></li>
        <li class="splide__slide"><img src="{{ '/images/gallery/disease-voc.png' | url }}" alt="Disease VOC" class="gallery-img"></li>
        <li class="splide__slide"><img src="{{ '/images/gallery/omed.png' | url }}" alt="OMED" class="gallery-img"></li>
        <li class="splide__slide"><img src="{{ '/images/gallery/voc-sphere.png' | url }}" alt="VOC Sphere" class="gallery-img"></li>
        <li class="splide__slide"><img src="{{ '/images/gallery/voc.png' | url }}" alt="VOC" class="gallery-img"></li>
        <li class="splide__slide"><img src="{{ '/images/gallery/actigraphy.png' | url }}" alt="Actigraphy" class="gallery-img"></li>
      </ul>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Splide !== 'undefined') {
      new Splide('#gallery-carousel', {
        type   : 'loop',
        drag   : 'free',
        focus  : 'center',
        autoWidth: true,
        gap    : '1rem',
        arrows : false,
        pagination: false,
        autoScroll: {
          speed: 1,
          pauseOnHover: true,
          pauseOnFocus: false,
        },
      }).mount(window.splide.Extensions);
    }
  });
</script>

<section id="cv" class="spa-section mb-5">
  <h2 class="mb-4 pb-2 border-bottom" style="font-family: 'Mackinac', serif;">Employment History</h2>
  <div class="timeline">
    {% for job in cv.employmentHistory %}
      <div class="card timeline-item mb-4 shadow-sm border-0 bg-transparent">
        <div class="card-body">
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
            {% if job.logo %}
              <img src="{{ job.logo | url }}" alt="{{ job.company }}" class="logo me-2">
            {% endif %}
            <div style="display: flex; flex-direction: column;">
              <h3 class="card-title h4" style="font-family: 'Mackinac', serif;">{{ job.role }}</h3>
              <h6 class="card-subtitle mb-3 text-primary">{{ job.company }} &bull; {{ job.duration }}</h6>
            </div>
          </div>
          <p class="card-text">{{ job.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>

  <h2 class="mt-5 mb-4 pb-2 border-bottom" style="font-family: 'Mackinac', serif;">Qualifications</h2>
  <div class="row g-4 mt-2">
    {% for qual in cv.qualifications %}
      <div class="col-md-6">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body">
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
              {% if qual.logo %}
                <img src="{{ qual.logo | url }}" alt="{{ qual.company }}" class="logo me-2">
              {% endif %}
              <div style="display: flex; flex-direction: column;">
                <h3 class="card-title h4" style="font-family: 'Mackinac', serif;">{{ qual.degree }}</h3>
                <h6 class="card-subtitle mb-3 text-primary">{{ qual.institution }} &bull; {{ qual.year }}</h6>
              </div>
            </div>
            <dl>
              {% if qual.award %}
                <dt class="text-muted">Awarded</dt>
                <dd class="mb-3">{{ qual.award }}</dd>
              {% endif %}
              {% if qual.thesis %}
                <dt class="text-muted">Thesis</dt>
                <dd class="mb-3">{{ qual.thesis }}</dd>
              {% endif %}
            </dl>
            {% if qual.link %}
              <a href="{{ qual.link | url }}" class="stretched-link text-decoration-none text-body">
                <i class="bi bi-arrow-right text-white float-end"></i>
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<section id="projects" class="spa-section mb-5" x-data="{ filter: 'all' }">
  <h2 class="mb-4 pb-2 border-bottom" style="font-family: 'Mackinac', serif;">Featured Work</h2>
  <div class="row g-4 mt-2">
    {% for item in collections.portfolio | reverse %}
      {% if item.data.pinned %}
        <div class="col-12">
          <div class="card shadow-sm border-0 position-relative flex-md-row">
            {% if item.data.image %}
              <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="card-img-top card-img-md-left" style="object-fit: cover; max-width: 100%;">
            {% endif %}
            <div class="card-body">
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
                <span class="badge bg-secondary-outline text-secondary">
                {% for tag in item.data.tags %}
                  {% if tag != "portfolio" %}{{ tag }} {% endif %}
                {% endfor %}
                </span>
              </div>
              <h3 style="font-family: 'Mackinac', serif;"><a href="{{ item.url | url }}" class="stretched-link text-decoration-none text-body">{{ item.data.title }}</a></h3>
              <p>{{ item.data.description }}</p>
              {% if item.data.stack %}
                {% for tool in item.data.stack %}
                  <span class="badge bg-primary-subtle text-primary me-1">{{ tool }}</span>
                {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <h2 class="mt-5 mb-4 pb-2 border-bottom" style="font-family: 'Mackinac', serif;">All Projects</h2>
  <div class="d-flex justify-content-center gap-2 mb-4 flex-wrap">
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'all' }" @click="filter = 'all'">All</button>
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'UI' }" @click="filter = 'UI'">UI Work</button>
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'Software' }" @click="filter = 'Software'">Software</button>
    <button class="btn btn-outline-primary" :class="{ 'active': filter === 'Other' }" @click="filter = 'Other'">Other</button>
  </div>

  <div class="row g-4">
    {% for item in collections.portfolio | reverse %}
      <div class="col-12 portfolio-item" x-show="filter === 'all' || '{{ item.data.tags | join(' ') }}'.includes(filter)" x-transition.opacity.duration.400ms>
        <div class="card h-100 shadow-sm border-0 position-relative flex-md-row">
          {% if item.data.image %}
            <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="card-img-top" style="object-fit: cover; max-width: 100%;">
          {% endif %}
          <div class="card-body">
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
              <span class="badge bg-secondary-subtle text-secondary">
              {% for tag in item.data.tags %}
                {% if tag != "portfolio" %}{{ tag }} {% endif %}
              {% endfor %}
              </span>
            </div>
            <h3 style="font-family: 'Mackinac', serif;"><a href="{{ item.url | url }}" class="stretched-link text-decoration-none text-body">{{ item.data.title }}</a></h3>
            <p>{{ item.data.description }}</p>
            {% if item.data.stack %}
              {% for tool in item.data.stack %}
                <span class="badge bg-primary-subtle text-primary me-1">{{ tool }}</span>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
