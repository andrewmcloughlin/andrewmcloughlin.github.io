---
layout: base.njk
title: All Projects
description: Browse all projects by Andrew McLoughlin, filtered by technology stack or category.
---

<section id="projects" class="page-section hero-section" aria-label="Featured case studies">
  <h1 class="hero-title">I'm Andrew,</h1>
  <h2 class="hero-subtitle">I make scientific software</h2>
  <p>Here's some of my favourite work:</p>
  {% include "components/gallery-carousel.njk" %}
</section>


<section class="narrow-page page-section product-section fade-in delay-2" x-data="{ expandedProducts: false }" aria-labelledby="products-heading">
  <h2 class="section-title" id="products-heading">Products I've worked on</h2>
  <div class="product-grid" id="products-list">
    {% set pinnedProducts = cv.products | selectattr("pinned") | list %}
    {% set unpinnedProducts = cv.products | rejectattr("pinned") | list %}
    {% set allProducts = pinnedProducts.concat(unpinnedProducts) %}
    {% for product in allProducts %}
        <div class="{% if product.pinned %}product-wrapper--pinned{% else %}product-wrapper--regular{% endif %}" {% if loop.index > 4 %} x-show="expandedProducts" x-transition x-cloak {% endif %}>
          {% include "components/product-card.njk" %}
        </div>
    {% endfor %}
  </div>
  <div class="button-group-end">
    <button
      type="button"
      class="btn btn-outline btn-full"
      @click="expandedProducts = !expandedProducts"
      :aria-expanded="expandedProducts"
      aria-controls="products-list"
    >
      <span x-show="!expandedProducts">More Products</span>
      <span x-show="expandedProducts" x-cloak>Fewer Products</span>
  </button>
  </div>
</section>


<section class="narrow-page page-section filter-section fade-in delay-4" x-data="{ filter: 'all', stackFilter: '' }" aria-labelledby="case-studies-heading">
  <h2 class="section-title" id="case-studies-heading">Case Studies</h2>

  <div class="filter-group">
    {# <button class="btn btn-outline" :class="{ 'active': filter === 'all' }"      @click="filter = 'all'; stackFilter = ''">All</button>
    <button class="btn btn-outline" :class="{ 'active': filter === 'Product' }"  @click="filter = 'Product'; stackFilter = ''">Product</button>
    <button class="btn btn-outline" :class="{ 'active': filter === 'Software' }" @click="filter = 'Software'; stackFilter = ''">Software</button>
    <button class="btn btn-outline" :class="{ 'active': filter === 'Data' }"     @click="filter = 'Data'; stackFilter = ''">Data</button> #}
    <template x-if="filter === 'Software'">
      <div class="filter-group">
        {% for stackItem in collections.stackItems %}
          <button class="btn btn-outline-secondary" :class="{ 'active': stackFilter === '{{ stackItem }}' }" @click="stackFilter = stackFilter === '{{ stackItem }}' ? '' : '{{ stackItem }}'">{{ stackItem }}</button>
        {% endfor %}
      </div>
    </template>
  </div>

  <div class="grid-list grid-gap-sm">
    {% for item in collections.blog | sort(false, false, 'data.index') %}
        {% set cardIndex = loop.index %}
        <div class="grid-item blog-item" x-show="filter === 'all' || ('{{ item.data.tags | join(',') }}'.split(',').includes(filter) && (filter !== 'Software' || !stackFilter || '{{ (item.data.featured_stack or []) | join(',') }}'.split(',').includes(stackFilter)))" x-transition.opacity.duration.400ms>
          {% include "components/project-card.njk" %}
        </div>
    {% endfor %}
  </div>
</section>
