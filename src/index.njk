<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Splide !== 'undefined') {
      new Splide('#gallery-carousel', {
        type   : 'loop',
        drag   : 'free',
        focus  : 'center',
        autoWidth: true,
        gap    : '1rem',
        arrows : false,
        pagination: false,
        autoScroll: {
          speed: 1,
          pauseOnHover: true,
          pauseOnFocus: false,
        },
      }).mount(window.splide.Extensions);
    }

    /* Mobile: tap-to-reveal overlay, second tap navigates */
    if (window.matchMedia('(hover: none)').matches) {
      document.querySelectorAll('.gallery-link').forEach(function (link) {
        link.addEventListener('click', function (e) {
          const overlay = this.querySelector('.gallery-overlay');
          if (!overlay.classList.contains('gallery-overlay--active')) {
            e.preventDefault();
            document.querySelectorAll('.gallery-overlay--active').forEach(function (o) {
              o.classList.remove('gallery-overlay--active');
            });
            overlay.classList.add('gallery-overlay--active');
          }
          /* overlay already active → allow default navigation */
        });
      });
    }
  });
</script>

<section id="cv" class="spa-section mb-5 fade-in delay-4">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Employment History</h2>
  <div class="timeline">
    {% for job in cv.employmentHistory %}
      <div class="timeline-item {% if job.logo %}has-logo{% endif %}">
        {% if job.logo %}
          <img src="{{ job.logo | url }}" alt="{{ job.company }}" class="timeline-logo timeline-logo-absolute">
        {% endif %}
        <div class="card shadow-sm border-0 bg-body">
          <div class="card-body p-4">
            <div class="d-flex flex-nowrap align-items-start gap-3 mb-3">
              <div class="d-flex flex-column w-100">
                <h3 class="card-title h4 font-heading">{{ job.role }}</h3>
                <div class="card-subtitle mt-2 text-primary d-flex align-items-start text-uppercase" style="letter-spacing: 0.1em;">
                  {% if job.link %}
                    <a href="{{ job.link | url }}" target="_blank" rel="noopener noreferrer" class="d-flex align-items-center gap-2 text-decoration-none">
                      <h6 class="mb-0">{{ job.company }}</h6>
                      <i class="fa-solid fa-arrow-up-right-from-square text-secondary opacity-50" style="font-size: 0.75rem;"></i>
                    </a>
                  {% else %}
                    <h6 class="mb-0">{{ job.company }}</h6>
                  {% endif %}
                </div>
              </div>
              <div class="d-flex flex-column justify-content-end text-nowrap">
                <h6 class="card-subtitle mb-3 text-secondary fw-normal">{{ job.duration }}</h6>
              </div>
            </div>
            <p class="card-text text-muted">{{ job.description }}</p>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <h2 class="my-4 py-2 border-bottom font-heading">Qualifications</h2>
  <div class="timeline">
    {% for qual in cv.qualifications %}
      <div class="timeline-item {% if qual.logo %}has-logo{% endif %}">
        {% if qual.logo %}
          <img src="{{ qual.logo | url }}" alt="{{ qual.institution }}" class="timeline-logo timeline-logo-absolute">
        {% endif %}
        <div class="card shadow-sm border-0 bg-body">
          <div class="card-body p-4">
            <div class="d-flex flex-nowrap align-items-start gap-3 mb-3">
              <div class="d-flex flex-column w-100">
                <h3 class="card-title h4 font-heading">{{ qual.degree }}
                  <i class="fa-solid fa-arrow-up-right-from-square text-secondary opacity-50" style="font-size: 0.75rem;"></i>
                </h3>
                <div class="card-subtitle mt-2 text-primary d-flex align-items-start text-uppercase" style="letter-spacing: 0.1em;">
                  <h6 class="mb-0">{{ qual.institution }}</h6>
                </div>
              </div>
              <div class="d-flex flex-column justify-content-end text-nowrap">
                <h6 class="card-subtitle mb-3 text-secondary fw-normal">{{ qual.year }}</h6>
              </div>
            </div>
              <div class="card-text text-muted">Awarded: {{ qual.award | default('') }}</div>
              <p class="card-text text-muted">{{ qual.description | default('') }}</p>
              {% for thesis in qual.theses %}
                <p class="card-text text-muted">{{ thesis }}</p>
              {% endfor %}
          </div>
        </div>
      </div>
    {% endfor %}


    {% for cert in certificates %}
      {{cert}}
    {% endfor %}
  </div>
</section>

<section id="projects" class="spa-section mb-5 fade-in delay-5">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Featured Work</h2>
  <div class="row g-4 mt-2">
    {% for item in collections.portfolio | reverse %}
      {% if item.data.pinned %}
        <div class="col-12">
          <div class="project-card position-relative row g-4 mb-5">
            {% if item.data.image %}
              <div class="project-image-wrapper overflow-hidden col-12 col-md-8">
                <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="project-image w-100 object-fit-cover rounded-4">
              </div>
            {% endif %}
            <div class="project-content d-flex flex-column col-12 col-md-4 py-md-3 pe-md-3">
              <h3 class="project-title fs-2 fw-bold lh-sm mb-3"><a href="{{ item.url | url }}" class="stretched-link text-decoration-none text-body">{{ item.data.title }}</a></h3>
              <p class="text-secondary fs-6">{{ item.data.description }}</p>
              {% if item.data.featured_stack %}
                <div class="mt-2 mb-4">
                  {% for tool in item.data.featured_stack %}
                    <span class="badge bg-secondary-subtle text-secondary me-1">{{ tool }}</span>
                  {% endfor %}
                  {% if item.data.other_stack %}
                    {% set count = item.data.other_stack | length %}
                    <span class="badge bg-secondary-subtle text-secondary me-1">+{{ count }}</span>
                  {% endif %}
                </div>
              {% endif %}
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm" style="width: 48px; height: 48px; flex-shrink: 0;">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="d-flex justify-content-end mt-2">
    <a href="{{ '/projects/' | url }}" class="btn btn-outline-primary">See All Projects &rarr;</a>
  </div>
</section>

