---
layout: base.njk
title: Home
---

<section id="home" class="spa-section text-center align-items-center py-5">
  <div class="d-flex flex-column align-items-start justify-content-center">
    <div class="d-flex justify-content-start fade-in delay-1">
      <h1 class="fs-5 fw-bold mb-4 pt-4 ps-4 pb-0" style="font-family: var(--font-heading);">Hi, I'm Andrew,</h1>
    </div>
    <h1 class="display-4 fw-bold hero-title mb-4 pt-0 pb-4 ps-4 fade-in delay-2" style="font-family: var(--font-heading);">a full-stack developer<br>of scientific software</h1>
  </div>

  <div class="gallery-marquee-container mt-4 pt-4 splide fade-in delay-3" id="gallery-carousel">
    <div class="splide__track">
      <ul class="splide__list">
        <li class="splide__slide">
          <a href="{{ '/portfolio/atlas/' | url }}" class="gallery-link position-relative d-block">
            <video autoplay loop muted playsinline class="gallery-img" style="pointer-events: none;">
              <source src="{{ '/images/gallery/voc.mp4' | url }}" type="video/mp4">
            </video>
          
            <div class="gallery-overlay p-4">
              <span class="gallery-title mt-auto pt-4">Interactive 3D compound viewer</span>
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </a>
        </li>
          <li class="splide__slide">
          <a href="{{ '/portfolio/omed_app/' | url }}" class="gallery-link position-relative d-block">
            <img src="{{ '/images/gallery/omed.png' | url }}" alt="OMED" class="gallery-img">
            <div class="gallery-overlay p-4">
              <span class="gallery-title mt-auto pt-4">OMED Health app screen designs & user flows</span>
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </a>
        </li>
        <li class="splide__slide">
          <a href="{{ '/portfolio/atlas/' | url }}" class="gallery-link position-relative d-block">
            <video autoplay loop muted playsinline class="gallery-img" style="pointer-events: none;">
              <source src="{{ '/images/gallery/atlas-web.webm' | url }}" type="video/webm">
            </video>
          
            <div class="gallery-overlay p-4">
              <span class="gallery-title mt-auto pt-4">VOC Atlas: a public web app for breath science</span>
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </a>
        </li>
        <li class="splide__slide">
          <a href="{{ '/portfolio/tyto/' | url }}" class="gallery-link position-relative d-block">
            <img src="{{ '/images/gallery/actigraphy.png' | url }}" alt="Actigraphy" class="gallery-img">
            <div class="gallery-overlay p-4">
              <span class="gallery-title mt-auto pt-4">Algorithms to learn actigraphy from actimetry data</span>
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </a>
        </li>
        <li class="splide__slide">
          <a href="{{ '/portfolio/atlas/' | url }}" class="gallery-link position-relative d-block">
            <video autoplay loop muted playsinline class="gallery-img" style="pointer-events: none;">
              <source src="{{ '/images/gallery/disease-voc.mp4' | url }}" type="video/mp4">
            </video>
            <div class="gallery-overlay p-4">
              <span class="gallery-title mt-auto pt-4">Interactive mapping of VOC-disease relationships</span>
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </a>
        </li>
        <li class="splide__slide">
          <a href="{{ '/portfolio/atlas/' | url }}" class="gallery-link position-relative d-block">
            <img src="{{ '/images/gallery/voc-sphere.png' | url }}" alt="VOC Sphere" class="gallery-img">
            <div class="gallery-overlay p-4">
              <span class="gallery-title mt-auto pt-4">Interactive marketing for VOC Atlas</span>
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Splide !== 'undefined') {
      new Splide('#gallery-carousel', {
        type   : 'loop',
        drag   : 'free',
        focus  : 'center',
        autoWidth: true,
        gap    : '1rem',
        arrows : false,
        pagination: false,
        autoScroll: {
          speed: 1,
          pauseOnHover: true,
          pauseOnFocus: false,
        },
      }).mount(window.splide.Extensions);
    }
  });
</script>

<section id="cv" class="spa-section mb-5 fade-in delay-4">
  <h2 class="mb-4 pb-2 border-bottom" style="font-family: var(--font-heading);">Employment History</h2>
  <div class="timeline">
    {% for job in cv.employmentHistory %}
      <div class="timeline-item {% if job.logo %}has-logo{% endif %}">
        {% if job.logo %}
          <img src="{{ job.logo | url }}" alt="{{ job.company }}" class="timeline-logo timeline-logo-absolute">
        {% endif %}
        <div class="card shadow-sm border-0 bg-transparent">
          <div class="card-body">
            <div style="display: flex; flex-wrap: nowrap; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;">
              <div style="display: flex; flex-direction: column;">
                <h3 class="card-title h4" style="font-family: var(--font-heading);">{{ job.role }}</h3>
                <h6 class="card-subtitle mb-3 text-primary">{{ job.company }} &bull; {{ job.duration }}</h6>
              </div>
            </div>
            <p class="card-text text-muted">{{ job.description }}</p>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  <h2 class="mt-5 mb-4 pb-2 border-bottom" style="font-family: var(--font-heading);">Qualifications</h2>
  <div class="row g-4 mt-2">
    {% for qual in cv.qualifications %}
      {% if qual.degree %}
        <div class="col-md-6">
          <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
              <div style="display: flex; flex-wrap: nowrap; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;">
                {% if qual.logo %}
                  <img src="{{ qual.logo | url }}" alt="{{ qual.institution }}" class="timeline-logo">
                {% endif %}
                <div style="display: flex; flex-direction: column;">
                  <h3 class="card-title h4" style="font-family: var(--font-heading);">{{ qual.degree }}</h3>
                  <h6 class="card-subtitle mb-3 text-primary">{{ qual.institution }} &bull; {{ qual.year }}</h6>
                </div>
              </div>
              <dl>
                {% if qual.award %}
                  <dt class="text-muted">Awarded</dt>
                  <dd class="mb-3">{{ qual.award }}</dd>
                {% endif %}
                {% if qual.thesis %}
                  <dt class="text-muted">Thesis</dt>
                  <dd class="mb-3">{{ qual.thesis }}</dd>
                {% endif %}
              </dl>
              {% if qual.link %}
                <a href="{{ qual.link | url }}" class="stretched-link text-decoration-none text-body">
                  <i class="bi bi-arrow-right text-white float-end"></i>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
    
    <div class="col-md-6">
      <div class="h-100 border-0">
        <div>
          <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; margin-bottom: 1rem;">
            {% for qual in cv.qualifications %}
              {% if qual.name %}
                <div class="cert-chip d-flex align-items-center gap-2 px-3 py-2 w-100">
                  <div>
                    <b class="fw-600" style="font-size: 0.9rem; line-height: 1.2;">{{ qual.name }}</b>
                    {% if qual.institution %}
                      <div class="text-muted" style="font-size: 0.75rem;">{{ qual.institution }} &bull; {{ qual.year }}</div>
                    {% else %}
                      <div class="text-muted" style="font-size: 0.75rem;">{{ qual.year }}</div>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        </div>
    </div>
  </div>
</section>

<section id="projects" class="spa-section mb-5 fade-in delay-5">
  <h2 class="mb-4 pb-2 border-bottom" style="font-family: var(--font-heading);">Featured Work</h2>
  <div class="row g-4 mt-2">
    {% for item in collections.portfolio | reverse %}
      {% if item.data.pinned %}
        <div class="col-12">
          <div class="project-card position-relative d-flex flex-column flex-md-row gap-4 mb-5">
            {% if item.data.image %}
              <div class="project-image-wrapper w-100 w-md-65">
                <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="project-image w-100" style="object-fit: cover;">
              </div>
            {% endif %}
            <div class="project-content d-flex flex-column w-100 w-md-35 py-md-3 pe-md-3">
              <h3 class="project-title mb-3"><a href="{{ item.url | url }}" class="stretched-link text-decoration-none text-body">{{ item.data.title }}</a></h3>
              <p class="text-secondary" style="font-size: 1.1rem;">{{ item.data.description }}</p>
              {% if item.data.featured_stack %}
                <div class="mt-2 mb-4">
                  {% for tool in item.data.featured_stack %}
                    <span class="badge bg-secondary-subtle text-secondary me-1">{{ tool }}</span>
                  {% endfor %}
                  {% if item.data.other_stack %}
                    {% set count = item.data.other_stack | length %}
                    <span class="badge bg-secondary-subtle text-secondary me-1">+{{ count }}</span>
                  {% endif %}
                </div>
              {% endif %}
              <div class="mt-auto d-flex justify-content-end w-100 pt-3">
                <div class="project-link-btn d-flex align-items-center justify-content-center bg-dark text-white rounded-circle shadow-sm">
                  <i class="fa-solid fa-arrow-right" style="transform: rotate(-45deg);"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <div class="d-flex justify-content-end mt-2">
    <a href="{{ '/projects/' | url }}" class="btn btn-outline-primary">See All Projects &rarr;</a>
  </div>
</section>

