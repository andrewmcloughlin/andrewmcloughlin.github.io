---
layout: base.njk
title: All Projects
description: Browse all projects by Andrew McLoughlin, filtered by technology stack or category.
---

<section id="projects" class="page-section mb-5 py-5 mt-5 text-center">
  <h2 class="my-5 pt-5 fs-1 fw-semibold">I'm Andrew,</h2>
  <h2 class="my-5 pb-5 fs-1 fw-normal">I make scientific software</h2>
  <p>Here's some of my favourite work:</p>
  {% include "components/gallery-carousel.njk" %}
</section>


<section class="page-section mb-5 fade-in delay-2" x-data="{ expandedProducts: false }">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Products I've worked on</h2>
  <div class="row g-4" id="products-list">
    {% for product in cv.products %}
        <div class="col-12 portfolio-item" {% if loop.index > 4 %} x-show="expandedProducts" x-transition x-cloak {% endif %}>
          {% include "components/product-card.njk" %}
        </div>
    {% endfor %}
  </div>
  <div class="d-flex justify-content-end mt-4">
    <button
      type="button"
      class="btn btn-outline w-100 py-2"
      @click="expandedProducts = !expandedProducts"
      :aria-expanded="expandedProducts"
      aria-controls="products-list"
    >
      <span x-show="!expandedProducts">More Products</span>
      <span x-show="expandedProducts" x-cloak>Fewer Products</span>
  </button>
  </div>
</section>


<section class="page-section mb-5 fade-in delay-4" x-data="{ filter: 'all', stackFilter: '' }">
  <h2 class="mb-4 pb-2 border-bottom font-heading">Case Studies</h2>

  <div class="d-flex justify-content-center align-items-center gap-2 mb-4 flex-wrap">
    {# <button class="btn btn-outline" :class="{ 'active': filter === 'all' }"      @click="filter = 'all'; stackFilter = ''">All</button>
    <button class="btn btn-outline" :class="{ 'active': filter === 'Product' }"  @click="filter = 'Product'; stackFilter = ''">Product</button>
    <button class="btn btn-outline" :class="{ 'active': filter === 'Software' }" @click="filter = 'Software'; stackFilter = ''">Software</button>
    <button class="btn btn-outline" :class="{ 'active': filter === 'Data' }"     @click="filter = 'Data'; stackFilter = ''">Data</button> #}
    <template x-if="filter === 'Software'">
      <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
        {% for stackItem in collections.stackItems %}
          <button class="btn btn-outline-secondary" :class="{ 'active': stackFilter === '{{ stackItem }}' }" @click="stackFilter = stackFilter === '{{ stackItem }}' ? '' : '{{ stackItem }}'">{{ stackItem }}</button>
        {% endfor %}
      </div>
    </template>
  </div>

  <div class="row g-2">
    {% asyncEach item in collections.portfolio | reverse %}
        <div class="col-12 portfolio-item" x-show="filter === 'all' || ('{{ item.data.tags | join(',') }}'.split(',').includes(filter) && (filter !== 'Software' || !stackFilter || '{{ (item.data.featured_stack or []) | join(',') }}'.split(',').includes(stackFilter)))" x-transition.opacity.duration.400ms>
          {% include "components/project-card.njk" %}
        </div>
    {% endeach %}
  </div>
</section>
